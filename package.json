{
  "name": "douban-mcp-cli",
  "version": "1.0.1",
  "description": "Douban MCP server + agent-native CLI for movies, books, and personal collections (npm name: douban-mcp-cli; product: douban-mcp)",
  "main": "dist/index.js",
  "bin": {
    "douban-mcp-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:version": "node --import tsx scripts/sync-version.ts",
    "build:skill-md": "node --import tsx scripts/build-skill-md.ts",
    "prebuild": "pnpm sync:version",
    "build": "tsc",
    "dev": "node --import tsx src/index.ts",
    "lint": "eslint src __tests__",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "pnpm sync:version && pnpm build"
  },
  "keywords": [
    "douban",
    "mcp",
    "model-context-protocol",
    "agent",
    "claude",
    "movies",
    "books"
  ],
  "author": "JackJin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackjin1997/douban-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "dotenv": "^18.0.9",
    "node-cache": "^5.1.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "execa": "^9.6.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
